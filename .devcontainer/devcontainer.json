{
  "name": "pubnet-tools",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "dev",
  "mounts": [
    "source=pubnet-tools-cargo-registry,target=/home/dev/.cargo/registry,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/dev/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude"
  },
  "postCreateCommand": "sudo chown -R dev:dev /home/dev/.cargo/registry /home/dev/.claude && cargo fetch",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
