{
  "name": "conncheck",
  "version": "0.1.0",
  "description": "Audit the public WiFi or network you just joined.",
  "type": "module",
  "bin": {
    "conncheck": "src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "start": "tsx src/index.ts"
  },
  "license": "MIT",
  "author": "Maxwell Hampton <h@hamptonmaxwell.com>",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
